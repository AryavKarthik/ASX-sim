# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Claude API key for the AI coach (needed from week 3). Get one at console.anthropic.com
# and set a monthly spend limit there as a hard backstop.
ANTHROPIC_API_KEY=

# Models for the AI coach: cheap everyday chat, and a stronger "deep review" model.
COACH_CHAT_MODEL=claude-haiku-5-5
COACH_REVIEW_MODEL=claude-sonnet-5-5
# The app stops calling the API once this much (USD) has been spent in a calendar month.
COACH_MONTHLY_BUDGET_USD=10

# Where recorded market data lives on this machine (a local clone of the private data repo).
ASXSIM_DATA_DIR=../ASX-sim-data

# Where your simulated live account is saved (kept outside the repo). Defaults to ~/.asxsim
# ASXSIM_STATE_DIR=~/.asxsim
